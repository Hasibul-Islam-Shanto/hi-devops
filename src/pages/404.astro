---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <section class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="not-found-title">Page not found</h1>
    <p class="not-found-desc">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="not-found-link">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Back to home
    </a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 480px;
    margin: 6rem auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  .not-found-code {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-accent);
    margin-bottom: 0.5rem;
  }

  .not-found-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .not-found-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .not-found-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-accent);
    text-decoration: none;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--color-panel-border);
    background: var(--color-panel-bg);
    box-shadow: var(--card-shadow);
    transition:
      border-color var(--transition-fast, 180ms ease),
      background var(--transition-fast, 180ms ease);
  }

  .not-found-link:hover {
    border-color: var(--color-border-hover);
    background: var(--color-table-header);
  }
</style>
