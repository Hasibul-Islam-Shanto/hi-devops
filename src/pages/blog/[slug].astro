---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.tsx';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings: rawHeadings } = await render(entry);
const headings = rawHeadings.map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const coverImage = entry.data.coverImage;
const socialImage = entry.data.socialImage ?? coverImage;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  pubDate={entry.data.pubDate}
  tags={entry.data.tags}
  ogImage={socialImage}
>
  <div class="blog-layout">
    <article class="prose content-panel blog-article">
      <header class="blog-header">
        <h1>{entry.data.title}</h1>

        <div class="blog-meta">
          <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{entry.data.readTime}</span>
        </div>

        {
          entry.data.tags.length > 0 && (
            <div class="blog-tags" aria-label="Post tags">
              {entry.data.tags.map((tag: string) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          )
        }

        {
          coverImage && (
            <img
              src={coverImage}
              alt={`${entry.data.title} cover`}
              class="blog-cover"
              width="1672"
              height="941"
              loading="eager"
              decoding="async"
            />
          )
        }
      </header>

      <Content />

      <div class="blog-back">
        <a href="/blog">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Back to Blog
        </a>
      </div>
    </article>

    <aside class="toc-panel content-panel">
      <TableOfContents headings={tocHeadings} client:idle />
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--toc-width);
    gap: 0.5rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0.5rem 0.75rem;
    align-items: start;
  }

  .blog-article {
    min-width: 0;
    width: 100%;
    max-width: none;
  }

  .blog-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-header h1 {
    margin-top: 0;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .blog-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-text-accent);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .blog-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 941;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--code-bg);
  }

  .toc-panel.content-panel {
    position: sticky;
    top: 80px;
    height: fit-content;
  }

  .blog-back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .blog-back a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-accent);
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .blog-back a:hover {
    gap: 0.55rem;
  }

  @media (max-width: 900px) {
    .blog-layout {
      grid-template-columns: 1fr;
    }

    .toc-panel {
      display: none;
    }
  }
</style>
