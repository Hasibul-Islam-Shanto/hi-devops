---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const dockerEntries = await getCollection('docker');
const subtopics = dockerEntries
  .map((e) => ({
    slug: e.id,
    title: e.data.title,
    description: e.data.description,
    order: e.data.order,
  }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Docker"
  description="Containerise applications — images, Dockerfiles, networking, volumes, and Compose."
  ogImage="/images/docker-site.webp"
>
  <section class="dk-header">
    <div class="dk-title-row">
      <div class="dk-icon" aria-hidden="true">
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#06b6d4"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
          <path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      </div>
      <h1 class="dk-title">Docker</h1>
    </div>

    <p class="dk-desc">
      Package apps into portable containers. Learn the fundamentals, write Dockerfiles, manage
      images, and orchestrate multi-service setups with Compose.
    </p>
  </section>

  <section class="dk-cards">
    <div class="dk-grid">
      {
        subtopics.map((sub, i) => (
          <a href={`/topics/docker/${sub.slug}`} class="dk-card" style={`--i:${i}`}>
            <div class="dk-card-top">
              <span class="dk-order">{String(sub.order).padStart(2, '0')}</span>
            </div>
            <h2 class="dk-card-title">{sub.title}</h2>
            <p class="dk-card-desc">{sub.description}</p>
            <span class="dk-card-cta">
              Read notes
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes dk-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dk-header {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    animation: dk-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .dk-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }

  .dk-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dk-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .dk-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.75;
  }

  .dk-cards {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 2rem 6rem;
  }

  .dk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.125rem;
  }

  .dk-card {
    display: block;
    text-decoration: none;
    padding: 1.375rem;
    border-radius: 14px;
    background: var(--color-panel-bg);
    border: 1px solid var(--color-panel-border);
    box-shadow: var(--card-shadow);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
    animation: dk-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 50ms + 80ms) both;
  }
  .dk-card:hover {
    transform: translateY(-4px);
    border-color: rgba(6, 182, 212, 0.28);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .dk-card-top {
    margin-bottom: 0.875rem;
  }

  .dk-order {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #06b6d4;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .dk-card-title {
    font-size: 1.025rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .dk-card-desc {
    font-size: 0.855rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .dk-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #06b6d4;
    transition: gap 0.18s ease;
  }
  .dk-card:hover .dk-card-cta {
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    .dk-header {
      padding: 3.5rem 1.25rem 2rem;
    }
    .dk-cards {
      padding: 2rem 1.25rem 5rem;
    }
  }
</style>
