---
import { socialLinks } from '../data/socialLinks';
---

<footer class="mt-auto py-6 px-4">
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-3">
    <div class="flex items-center gap-2 text-sm text-(--color-text-muted)">
      <span>Built with</span>
      <span class="text-red-400/80">♥</span>
      <span>by</span>
      <span
        class="font-semibold bg-linear-to-r from-(--color-aurora-1) to-(--color-aurora-2) bg-clip-text text-transparent"
      >
        Hasibul Islam Shanto
      </span>
    </div>

    <div class="flex items-center gap-3">
      {
        socialLinks.map((link, index) => (
          <>
            {index > 0 && <span class="text-[var(--color-border)] select-none">·</span>}
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="flex items-center gap-1.5 text-xs text-[var(--color-text-muted)] hover:text-[var(--color-aurora-1)] transition-colors duration-150"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={link.path} />
              </svg>
              {link.name}
            </a>
          </>
        ))
      }
    </div>
  </div>
</footer>
